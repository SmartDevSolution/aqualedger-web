{
  "name": "aqualedger-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.9.7 <11"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript contracts/openapi.json --output src/lib/api/generated.ts",
    "contracts:check": "node scripts/check-contract.mjs",
    "messages:check": "node scripts/check-messages.mjs",
    "check-no-token-leak": "node scripts/check-no-token-leak.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:unconfigured": "node scripts/build-unconfigured.mjs && playwright test --config playwright.unconfigured.config.ts",
    "test": "npm run messages:check && npm run contracts:check && npm run check-no-token-leak && npm run test:e2e && npm run test:e2e:unconfigured"
  },
  "dependencies": {
    "@turf/area": "7.4.0",
    "@turf/boolean-valid": "7.4.0",
    "maplibre-gl": "6.11.2",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "terra-draw": "1.35.0",
    "terra-draw-maplibre-gl-adapter": "1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "openapi-typescript": "7.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
