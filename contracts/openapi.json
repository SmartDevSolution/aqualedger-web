      "EffectiveCoverage": {
        "description": "Which acquisition, if any, the persisted statistics describe (freeze B2 rule 5).",
        "properties": {
          "acquisition_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
