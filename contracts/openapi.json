            "title": "Band",
            "type": "string"
          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "reason": {
            "enum": [
              "asset_missing",
              "asset_href_missing",
              "asset_scale_missing"
            ],
            "title": "Reason",
            "type": "string"
          },
          "tile_id": {
            "title": "Tile Id",
            "type": "string"
          }
        },
        "required": [
