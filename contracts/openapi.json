      "StacItemFailure": {
        "description": "A missing STAC asset requirement for one band of one item (D4, ratified text D). No\n`detail` key; `SOURCE_ITEM_INCOMPLETE` never appears here or anywhere else published.",
        "properties": {
          "acquisition_date": {
            "format": "date",
