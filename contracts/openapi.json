        "type": "object"
      },
      "EvidenceStatus": {
        "description": "M1 is deliberately blunt (freeze rev.3): every completed run is NOT_ASSESSED except a\nzero-valid-observation run, which is INSUFFICIENT. SUFFICIENT/LIMITED exist in the enum for\nlater milestones and MUST NOT be emitted by M1 logic.",
        "enum": [
          "NOT_ASSESSED",
          "SUFFICIENT",
          "LIMITED",
          "INSUFFICIENT"
        ],
        "title": "EvidenceStatus",
        "type": "string"
      },
      "ExecutionStatus": {
        "enum": [
          "QUEUED",
          "RUNNING",
          "RETRY_WAIT",
          "SUCCEEDED",
          "FAILED"
